# Copy this file to .env.local and fill in your own Supabase project's values.
# Get these from your Supabase project dashboard: Settings -> API.
#
# Never put the service_role key here (or anywhere in frontend code) —
# only the public anon key belongs on the client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (Phase 27B — one-time bid payments). Test-mode only; there is no
# client-side Stripe key here on purpose — the frontend never talks to
# Stripe directly, it only calls the create-bid-payment Edge Function and
# redirects to the Checkout URL it returns. The secret key, the webhook
# signing secret, and the site URL used to build Checkout's success/cancel
# links are Edge Function secrets (`supabase secrets set ...`), never
# frontend env vars:
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   SITE_URL
